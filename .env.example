# Use only the public Supabase anon/publishable key in browser builds.
# NEVER put a service_role key in a VITE_* variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional public Cloudflare Turnstile site key; server secret belongs in Supabase Auth CAPTCHA settings.
VITE_TURNSTILE_SITE_KEY=
